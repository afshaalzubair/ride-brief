  "definitions": [
    {
      "topic": "Question",
      "rule": "Among people killed on motorcycles in U.S. traffic crashes in 2023, how were helmet use, police-reported alcohol involvement, time of day, and state distributed?"
    },
    {
      "topic": "Source",
      "rule": "NHTSA Fatality Analysis Reporting System, 2023 Final National CSV. The 2024 national file is an Annual Report File and can still be revised, so this briefing stays on the final year."
    },
    {
      "topic": "Geography",
      "rule": "The national file covers the 50 states and the District of Columbia. Puerto Rico is published separately and is not included."
    },
    {
      "topic": "Fatal crash",
      "rule": "A crash in the accident file in which at least one in-transport vehicle has body type 80 through 89."
    },
    {
      "topic": "Motorcyclist killed",
      "rule": "A person in the person file with injury severity 4 (fatal), person type 1 (operator) or 2 (passenger), and body type 80 through 89. Injury severity 6 (died prior to the crash) is excluded. Unknown occupant type is excluded and counted in the quality checks."
    },
    {
      "topic": "Other people killed",
      "rule": "People with injury severity 4 in a motorcycle-involved fatal crash who are not in the motorcyclist-killed set. They include occupants of other vehicles, pedestrians, and bicyclists."
    },
    {
      "topic": "Helmet",
      "rule": "Used means HELM_USE 5, 16, or 19. Not used means 17. Every other code, including not reported and unknown, stays in Unknown. Unknown is never folded into not used."
    },
    {
      "topic": "Police-reported alcohol",
      "rule": "DRINKING is the officer's judgment. 1 is involved, 0 is not involved, 8 and 9 stay unknown. The manual says this element does not mean alcohol caused the crash. It is not NHTSA's alcohol-impaired-driving statistic, which uses measured and imputed blood alcohol concentration."
    },
    {
      "topic": "Numeric BAC",
      "rule": "ALC_RES values 0 through 940 are numeric results, in units of 0.001 g/dL, so 80 means 0.08 g/dL. Value 940 means 0.94 g/dL or greater and is counted as at or above 0.08. Values 995 through 999 are not numeric. This briefing does not impute missing tests."
    },
    {
      "topic": "Time of day",
      "rule": "NCSA classification: daytime is hour 6 through 17 (6:00 a.m. through 5:59 p.m.). Nighttime is hours 0 through 5 and 18 through 23. Hour 99 or a missing hour is unknown."
    },
    {
      "topic": "Week part",
      "rule": "NCSA classification: weekend runs from 6:00 p.m. Friday through 5:59 a.m. Monday. Hours that fall in neither the weekday nor the weekend rule are unknown."
    },
    {
      "topic": "What this cannot say",
      "rule": "FARS is a census of fatal crashes, not of all crashes and not of miles ridden. A state with more deaths is not shown to be more dangerous per mile. Helmet and alcohol figures describe people who died, not the effect of a helmet or of alcohol."
    }
  ]
}
